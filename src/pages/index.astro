---
import Layout from '../layouts/Layout.astro';
import { cv, profiles } from '../data/cv';
const base = import.meta.env.BASE_URL;
const profile = profiles['technical-lead'];
const roles = cv.pages.flat();
const techKey = (t: string) => t.toLowerCase().replace('.net', 'dotnet').replace('c++', 'cpp').replace(/[^a-z0-9]/g, '');
---

<Layout title="Sammy Deveille – Technical Lead">
  <main>
    <header class="hero">
      <div class="hero-title-row">
        <h1>Sammy Deveille</h1>
        <nav class="site-nav" aria-label="Site pages">
          <a href="/" class="site-nav-link active">Dev</a>
          <a href="/studio" class="site-nav-link">Studio</a>
        </nav>
      </div>
      <p class="subtitle">Technical Lead</p>
      <p class="tagline">{profile.profile}</p>
      <nav class="social-links">
        <a href="https://www.linkedin.com/in/sammydeveille/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://github.com/SammyDeveilleASP" target="_blank" rel="noopener" aria-label="GitHub (Professional)">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
        <a href="https://github.com/SammyDeveille" target="_blank" rel="noopener" aria-label="GitHub (Personal)" class="icon-personal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href="mailto:sammydeveille@gmail.com" aria-label="Email">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </a>
        <a href="/cv/technical-lead" aria-label="View CV">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
        </a>
      </nav>
    </header>

    <section id="experience">
      <h2>Experience</h2>

      {roles.map((r) => (
        <article id={(r.logo ?? '').replace('.png', '')} class="role">
          <details class="role-expand">
            <summary class="role-summary">
              <div class="role-header">
                <div class="role-left">
                  <img src={`${base}logos/${r.logo}`} alt={r.company} class="role-logo" />
                  <div class="role-info">
                    <span class="role-title">{r.title}</span>
                    <h3>{r.company}</h3>
                    <p class="role-desc">{r.tagline}</p>
                  </div>
                </div>
                <div class="role-right">
                  <span>{r.dates}</span>
                  <span>{r.sector}</span>
                  <span>{r.place}</span>
                </div>
              </div>

              {r.groups ? r.groups.map(([h, items]) => (
                <>
                  <h4>{h}</h4>
                  <ul>{items.map((b) => <li>{b}</li>)}</ul>
                </>
              )) : (
                <ul>{r.bullets.map((b) => <li>{b}</li>)}</ul>
              )}

              {r.tags && (
                <div class="tech-badges">
                  {r.tags.map((t) => <span data-tech={techKey(t)}>{t}</span>)}
                </div>
              )}
            </summary>
            <div class="role-expand-content"></div>
          </details>
        </article>
      ))}
    </section>

    <section id="skills">
      <h2>Skills</h2>

      <div class="two-col">
        <div class="col">
          <h3 class="col-title">Leadership</h3>
          {profile.leadership.map(([h, text]) => (
            <div class="skills-section">
              <h4>{h}</h4>
              <p>{text}</p>
            </div>
          ))}
        </div>

        <div class="col">
          <h3 class="col-title">Technical</h3>
          {cv.technical.map(([h, lines]) => (
            <div class="skills-section">
              <h4>{h}</h4>
              <p>{lines.join(' · ')}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="projects">
      <h2>Personal Projects</h2>

      <article class="role">
        <div class="role-header">
          <div class="role-left">
            <a href="https://github.com/sammydeveille/atlapse" target="_blank" rel="noopener" aria-label="atlapse on GitHub" class="project-link"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg></a>
            <div class="role-info">
              <h3>AtLapse</h3>
              <p class="role-desc">Interactive map rendering of spatial and time-series data</p>
            </div>
          </div>
        </div>
        <div class="tech-badges">
          <span data-tech="mapbox">Mapbox</span><span data-tech="nextjs">Next.js</span><span data-tech="sql">PostgreSQL</span><span data-tech="elk">Elasticsearch</span><span data-tech="docker">Docker</span>
        </div>
      </article>

      <article class="role">
        <div class="role-header">
          <div class="role-left">
            <a href="https://github.com/sammydeveille/cyber-bench" target="_blank" rel="noopener" aria-label="cyber-bench on GitHub" class="project-link"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg></a>
            <div class="role-info">
              <h3>cyber-bench</h3>
              <p class="role-desc">Portable security testing pipeline with automated vulnerability scanning</p>
            </div>
          </div>
        </div>
        <div class="tech-badges">
          <span data-tech="security">DefectDojo</span><span data-tech="security">DAST</span><span data-tech="docker">Docker</span>
        </div>
      </article>
    </section>

    <section id="education">
      <h2>Education</h2>

      {cv.education.map((e) => (
        <article class="role">
          <div class="role-header">
            <div class="role-left">
              <img src={`${base}logos/${e.logo}`} alt={e.school.join(' ')} class="role-logo" />
              <div class="role-info">
                <span class="role-title">{e.degree} {e.field}</span>
                <h3>{e.school.join(' ')}</h3>
              </div>
            </div>
            <div class="role-right">
              <span>{e.dates}</span>
              <span>{e.place}</span>
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  .role-expand {
    border: none;
    padding: 0;
  }

  .role-summary {
    list-style: none;
    cursor: pointer;
    display: block;
  }

  .role-summary::-webkit-details-marker { display: none; }
  .role-summary::marker { display: none; content: ''; }

  .role-expand-content {
    margin-top: 0.75rem;
    animation: fadeIn 0.2s ease;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .role-expand-content p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .role-expand-content p:last-child {
    margin-bottom: 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    flex-shrink: 0;
  }

  .site-nav-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.4;
  }

  .site-nav-link:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .site-nav-link.active {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>

<script>
  // Collapse others when one opens
  document.querySelectorAll('.role-expand').forEach(details => {
    details.addEventListener('toggle', () => {
      if (details.open) {
        document.querySelectorAll('.role-expand').forEach(other => {
          if (other !== details) other.open = false;
        });
        const id = details.closest('article')?.id;
        if (id) history.replaceState(null, '', '#' + id);
      } else {
        history.replaceState(null, '', window.location.pathname);
      }
    });
  });

  // Auto-open and scroll to role if hash matches
  function openFromHash() {
    const id = window.location.hash.slice(1);
    if (!id) return;
    const article = document.getElementById(id);
    if (!article) return;
    const details = article.querySelector('.role-expand');
    if (details) details.open = true;
    article.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
